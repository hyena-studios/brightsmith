# Data (local, not committed)
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Coverage
.coverage
htmlcov/
coverage.xml

# Test/lint caches (not committed, not gitignored before — permanent git status noise)
.pytest_cache/
.ruff_cache/

# DQ results (timestamped, can regenerate)
governance/dq-results/*.json

# DQ run history (timestamped runtime artifacts written when DQ executes)
governance/run-history/

# Staging archives
governance/tag-normalization/archive/

# Runtime governance outputs — produced when the framework runs its OWN pipeline
# during development. These are per-run artifacts, not shippable framework content
# (only governance/dq-rule-templates/ is tracked). Consumer projects track their own.
governance/reviews/
governance/audit-trail/
governance/runtime-artifacts/
governance/pipeline-state/
governance/dq-scorecards/
governance/insights/
governance/approvals/
governance/cab-decisions/
